# Server-side only (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
COAI_CRM_ENABLED=false
# Comma-separated Supabase Auth UUIDs allowed into HQ. Never use editable user metadata.
HQ_ADMIN_USER_IDS=
PAGESPEED_API_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Client-side safe (public, non-sensitive — prefixed with NEXT_PUBLIC_)
# Local dev only (http://localhost:3000). Deployed builds always use the canonical origin in lib/site.ts.
# If set in Vercel it MUST be exactly https://www.chaoticallyorganizedai.com — the API origin guard compares against it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_VAPI_API_KEY=
